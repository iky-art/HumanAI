# Copy this file to .env.local and fill in your own Supabase project values.
# Get these from: Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Note: HumanAI does NOT use a WhatsApp OTP provider or any other
# hidden API key to verify the WA number — that would work against
# the "no hidden API key" idea the product is built on. The number
# collected at signup is a plain contact field, manually confirmed
# the moment an operator actually talks to that person on WhatsApp.

# Only used by Cloudflare Pages Functions (server-side, never exposed
# to the browser) — for the payment gateway in a later stage.
# PAYMENT_GATEWAY_KEY=
